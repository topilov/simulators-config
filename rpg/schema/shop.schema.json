{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "shops"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "messages": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "NO_SUBSCRIPTION"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "shops": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/shop"
      }
    }
  },
  "$defs": {
    "shop": {
      "type": "object",
      "required": [
        "vault",
        "products"
      ],
      "additionalProperties": false,
      "properties": {
        "vault": {
          "type": "string",
          "minLength": 1
        },
        "products": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/product"
          }
        }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "title",
        "description",
        "icon",
        "price",
        "vault",
        "amount",
        "onPurchase"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "vault": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        },
        "isCounterEnabled": {
          "type": "boolean"
        },
        "onPurchase": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
