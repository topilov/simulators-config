{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "rarities",
    "pets"
  ],
  "additionalProperties": false,

  "properties": {
    "$schema": {
      "type": "string"
    },

    "rarities": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "COMMON",
          "RARE",
          "EPIC",
          "LEGENDARY",
          "MYTHIC"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/rarity"
      }
    },

    "pets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/pet"
      }
    }
  },

  "$defs": {
    "pet": {
      "type": "object",
      "required": [
        "title",
        "description",
        "icon",
        "rarity",
        "levels"
      ],
      "additionalProperties": false,

      "properties": {
        "title":  {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "icon": {
          "$ref": "#/$defs/icon"
        },

        "rarity": {
          "enum": [
            "COMMON",
            "RARE",
            "EPIC",
            "LEGENDARY",
            "MYTHIC"
          ]
        },

        "levels": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/petLevel"
          }
        }
      }
    },

    "rarity": {
      "type": "object",
      "required": [
        "title",
        "color"
      ],
      "additionalProperties": false,

      "properties": {
        "title": {
          "type": "string"
        },

        "color": {
          "$ref": "#/$defs/color"
        }
      }
    },

    "icon": {
      "type": "object",
      "required": [
        "kind",
        "resourceId",
        "modelId",
        "ownerTexture",
        "tint",
        "glint",
        "modelTagKey",
        "modelTag"
      ],
      "additionalProperties": false,

      "properties": {
        "kind": {
          "enum": [
            "ITEM_MODEL",
            "RESOURCE_TEXTURE"
          ]
        },

        "resourceId": {
          "type": "string"
        },

        "modelId": {
          "type": "integer"
        },

        "ownerTexture": {
          "type": [
            "string",
            "null"
          ]
        },

        "tint": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "null"
            }
          ]
        },

        "glint": {
          "type": "boolean"
        },

        "modelTagKey": {
          "type": [
            "string",
            "null"
          ]
        },

        "modelTag": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "color": {
      "type": "object",
      "required": [
        "hex"
      ],
      "additionalProperties": false,

      "properties": {
        "hex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },

    "petLevel": {
      "type": "object",
      "required": [
        "maxHealth",
        "attackCooldown",
        "damage"
      ],
      "additionalProperties": false,

      "properties": {
        "maxHealth": {
          "type": "number"
        },

        "attackCooldown": {
          "type": "number"
        },

        "damage": {
          "type": "number"
        }
      }
    }
  }
}
